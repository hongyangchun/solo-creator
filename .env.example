# LLM API 配置 (支持 DeepSeek / OpenAI 兼容接口)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 本地 CDP 浏览器配置
CHROME_CDP_ENDPOINT=http://127.0.0.1:9222

# 本地数据存储路径 (默认 ~/.solo-creator/solo_creator.db)
SOLO_CREATOR_DATA_DIR=~/.solo-creator

# 飞书 / 钉钉通知机器人 Webhook (可选)
FEISHU_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=

# 平台官方 API 凭据 (可选，未配置时自动降级走 CDP 浏览器直塞)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
X_API_BEARER_TOKEN=
